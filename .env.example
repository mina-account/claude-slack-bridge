SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_CHANNEL=#general
PROJECTS_DIR=/path/to/your/projects
HTTP_PORT=3409
# Path to the SQLite database for session persistence.
# Use an absolute path on a persistent volume in Docker (e.g. /data/sessions.db).
DB_PATH=sessions.db
# Optional shared secret for POST /callback authentication.
# When set, callers must send: Authorization: Bearer <value>
# Leave unset to disable auth (trusted-network / local-only deployments).
# CALLBACK_SECRET=
